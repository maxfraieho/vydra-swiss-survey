#!/usr/bin/env bash
# SDD pre-commit hook — advisory LLM arbiter check.
#
# Fail-open by design: this hook is easily bypassed with `git commit
# --no-verify`, so it is NOT the real gate for Invariant 5 (that gate is
# the build/test pipeline before push, via `bin/sdd_verify.sh --arbiter`).
# This hook exists to give fast, local, advisory feedback.
#
# Runs in shadow mode (--dry-run) by default — logs verdicts, never
# blocks — until an operator explicitly promotes it to blocking mode by
# setting SDD_JUDGE_SHADOW=0 in the environment (see
# specs/021-multiagent-sdd-extension/tasks.md T-148/T-149).
REPO_DIR="$(cd "$(git rev-parse --show-toplevel)" && pwd)"
cd "$REPO_DIR" || exit 0

if [ ! -f "scripts/sdd_llm_judge.py" ]; then
    exit 0
fi

if [ "${SDD_JUDGE_SHADOW:-1}" = "1" ]; then
    python3 scripts/sdd_llm_judge.py --staged --dry-run
else
    python3 scripts/sdd_llm_judge.py --staged
fi
